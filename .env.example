# Firebase — preencha com as credenciais do projeto
VITE_FIREBASE_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# E-mail seguro via Cloud Function (nunca coloque API keys aqui)
VITE_EMAIL_API_URL=

# Admin: desativar usuários Auth (Cloud Function setUserDisabled)
VITE_ADMIN_USER_API_URL=

# Seed dos administradores (scripts/seed-admins.mjs) — NÃO usar no frontend
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
